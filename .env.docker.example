# Copy to .env before docker compose up. Never commit real secrets.
SECURENEXUS_PORT=8000
LLM_KEY_ENCRYPTION_KEY=
# Optional Langfuse integration; keep disabled unless approved.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional Neo4j graph projection. SQLite remains the governance source of truth.
NEO4J_ENABLED=0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional local/external model endpoints are configured by the administrator
# in the backend. Do not put provider API keys in this example file.
