<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>网络安全 Agent · 管理后台</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/echarts-wordcloud@2/dist/echarts-wordcloud.min.js"></script>
<style>
:root{--bg:#f5f5f7;--card:#fff;--t:#1d1d1f;--t2:#6e6e73;--b:#e5e5ea;--a:#0071e3;--g:#34c759;--y:#ff9500;--r:#ff3b30;--f:-apple-system,BlinkMacSystemFont,"SF Pro SC","PingFang SC","Noto Sans SC","Microsoft YaHei",sans-serif}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--f);background:var(--bg);color:var(--t);height:100vh;overflow:hidden;display:flex;flex-direction:column}
.header{background:var(--card);border-bottom:1px solid var(--b);padding:12px 24px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.header h1{font-size:18px;font-weight:600;letter-spacing:-.01em}
.header .badge{font-size:11px;background:#e8f0fe;color:var(--a);padding:3px 10px;border-radius:12px;font-weight:500}
.header .status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px}
.header .status-dot.live{background:var(--g)}
.header .status-dot.dead{background:var(--r)}
.layout{display:flex;flex:1;overflow:hidden}
.sidebar{width:320px;min-width:320px;background:var(--card);border-right:1px solid var(--b);display:flex;flex-direction:column;flex-shrink:0}
.sidebar-header{padding:16px 16px 8px;border-bottom:1px solid var(--b)}
.sidebar-header input{width:100%;padding:8px 12px;border:1px solid var(--b);border-radius:8px;font-size:13px;font-family:var(--f);outline:none}
.sidebar-header input:focus{border-color:var(--a)}
.sidebar-header .stats{display:flex;gap:8px;margin-top:10px;font-size:11px;color:var(--t2)}
.sidebar-list{flex:1;overflow-y:auto;padding:4px 0}
.active-panel{background:#fff9e6;border-bottom:2px solid var(--y);padding:8px 16px;max-height:180px;overflow-y:auto}
.active-panel .active-title{font-size:11px;font-weight:600;color:var(--y);margin-bottom:6px;display:flex;justify-content:space-between}
.active-item{font-size:12px;padding:4px 0;border-bottom:1px solid #f0e8cc;display:flex;justify-content:space-between}
.active-item:last-child{border-bottom:none}
.active-item .ai-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:160px}
.active-item .ai-stage{font-size:11px;color:var(--y);flex-shrink:0}
.active-item .ai-stage::before{content:"⏳";margin-right:2px}
.conv-item{padding:10px 16px;cursor:pointer;border-bottom:1px solid #f0f0f2;transition:background .15s;position:relative}
.conv-item:hover{background:#f8f8fa}
.conv-item.active{background:#e8f0fe;border-left:3px solid var(--a);padding-left:13px}
.conv-item .title{font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:270px}
.conv-item .meta{font-size:11px;color:var(--t2);margin-top:2px;display:flex;gap:8px}
.conv-item .meta .dot{color:var(--g);font-size:8px}
.conv-item .new-badge{font-size:9px;background:var(--a);color:#fff;padding:1px 5px;border-radius:6px;margin-left:6px}
.main{flex:1;overflow-y:auto;padding:20px 28px;background:var(--bg)}
.main.empty{display:flex;align-items:center;justify-content:center;color:var(--t2);font-size:15px}
.main.empty .hint{text-align:center;line-height:1.8}
.main.empty .hint .icon{font-size:48px;display:block;margin-bottom:8px;opacity:.3}
.conv-header{margin-bottom:20px}
.conv-header h2{font-size:20px;font-weight:600}
.conv-header .meta{font-size:12px;color:var(--t2);margin-top:4px;display:flex;gap:12px;flex-wrap:wrap}
.stats-row{display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap}
.stat-card{background:var(--card);border:1px solid var(--b);border-radius:10px;padding:10px 16px;flex:1;min-width:100px;text-align:center}
.stat-card .num{font-size:22px;font-weight:700;display:block}
.stat-card .num.blue{color:var(--a)}
.stat-card .num.green{color:var(--g)}
.stat-card .num.orange{color:var(--y)}
.stat-card .num.red{color:var(--r)}
.stat-card .label{font-size:11px;color:var(--t2);margin-top:2px}
.msg-card{background:var(--card);border:1px solid var(--b);border-radius:12px;margin-bottom:14px;overflow:hidden}
.msg-card .msg-header{padding:8px 14px;font-size:11px;font-weight:600;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--b)}
.msg-card .msg-header.user{background:#e8f0fe;color:var(--a)}
.msg-card .msg-header.assistant{background:#f0f7f0;color:var(--g)}
.msg-card.msg-jailbreak{border:2px solid var(--r) !important;background:#fff5f5}
.msg-card.msg-jailbreak .msg-header.user{background:#ffe0e0}
.msg-card.msg-jailbreak .msg-header.assistant{background:#ffe0e0}
.msg-card .msg-header .time{font-weight:400;color:var(--t2)}
.msg-card .msg-body{padding:12px 14px;font-size:13px;line-height:1.7;white-space:pre-wrap;max-height:500px;overflow-y:auto}
.msg-card .msg-sources{padding:8px 14px;background:#fafafa;border-top:1px solid var(--b)}
.msg-card .msg-sources .src-title{font-size:11px;font-weight:600;color:var(--t2);margin-bottom:6px}
.src-item{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12px;border-bottom:1px solid #f0f0f2}
.src-item:last-child{border-bottom:none}
.src-item .bar-wrap{flex:1;height:6px;background:#eee;border-radius:3px;overflow:hidden;min-width:60px}
.src-item .bar-fill{height:100%;border-radius:3px;transition:width .3s}
.src-item .bar-fill.high{background:var(--g)}
.src-item .bar-fill.medium{background:var(--y)}
.src-item .bar-fill.low{background:var(--r)}
.src-item .file-name{font-size:11px;color:var(--t);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px;flex-shrink:1}
.src-item .conf-badge{font-size:10px;font-weight:600;padding:1px 6px;border-radius:4px;flex-shrink:0}
.src-item .conf-badge.high{background:#e8f5e9;color:#2e7d32}
.src-item .conf-badge.medium{background:#fff3e0;color:#e65100}
.src-item .conf-badge.low{background:#fce4ec;color:#c62828}
.src-item .section{font-size:10px;color:var(--t2);flex-shrink:0}
.cat-filter,.del-filter{font-size:12px;padding:4px 12px;border-radius:12px;cursor:pointer;background:var(--bg);color:var(--t2);border:1px solid var(--b);transition:all .15s;user-select:none;font-weight:500}
.cat-filter:hover,.del-filter:hover{border-color:var(--a);color:var(--a)}
.cat-filter.active,.del-filter.active{background:var(--a);color:#fff;border-color:var(--a)}
.empty-state{padding:40px 20px;text-align:center;color:var(--t2);font-size:13px}
.del-btn{font-size:11px;color:var(--r);cursor:pointer;padding:2px 6px;border-radius:4px;opacity:0;transition:opacity .15s}
.conv-item:hover .del-btn{opacity:1}
.del-btn:hover{background:#fce4ec}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#323232;color:#fff;padding:10px 20px;border-radius:8px;font-size:13px;z-index:999;opacity:0;transition:opacity .3s}
.toast.show{opacity:1}
.toast.new-conv{background:var(--a)}
.tab-bar{display:flex;gap:0;border-bottom:1px solid var(--b);margin-bottom:16px;background:var(--card);border-radius:10px 10px 0 0;overflow:hidden;flex-shrink:0}
.tab-item{padding:10px 20px;font-size:13px;font-weight:500;cursor:pointer;color:var(--t2);border-bottom:2px solid transparent;transition:all .15s;user-select:none}
.tab-item:hover{color:var(--t);background:#f8f8fa}
.tab-item.active{color:var(--a);border-bottom-color:var(--a);background:#e8f0fe}
.tab-content{display:none}
.tab-content.active{display:block}
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.chart-card{background:var(--card);border:1px solid var(--b);border-radius:10px;padding:16px}
.chart-card .chart-title{font-size:13px;font-weight:600;color:var(--t2);margin-bottom:8px}
.chart-card .chart-box{width:100%;height:300px}
.chart-card.full{grid-column:1/-1}
.chart-card.full .chart-box{height:380px}
.health-row{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.health-card{background:var(--card);border:1px solid var(--b);border-radius:10px;padding:12px 16px;flex:1;min-width:120px;text-align:center}
.health-card .hnum{font-size:18px;font-weight:700;display:block}
.health-card .hnum.green{color:var(--g)}
.health-card .hnum.orange{color:var(--y)}
.health-card .hnum.blue{color:var(--a)}
.health-card .hlbl{font-size:10px;color:var(--t2);margin-top:2px}
.conv-item.deleted{opacity:.45;background:#fafafa}
.conv-item.deleted .deleted-badge{font-size:9px;color:var(--r);padding:1px 4px;border:1px solid var(--r);border-radius:4px;margin-left:6px}
.group-header{font-size:11px;font-weight:600;color:var(--t2);padding:6px 16px 4px;cursor:pointer;user-select:none;display:flex;justify-content:space-between;border-bottom:1px solid #f0f0f2;margin-top:4px}
.group-header:hover{color:var(--t)}
.group-header .arrow{transition:transform .15s;display:inline-block}
.group-header .arrow.collapsed{transform:rotate(-90deg)}
.group-items{overflow:hidden;transition:max-height .2s}
.group-items.collapsed{max-height:0}
.filter-toggle{display:flex;gap:4px;margin-top:8px;font-size:11px}
.filter-toggle .opt{padding:2px 8px;border-radius:6px;cursor:pointer;color:var(--t2);border:1px solid var(--b)}
.filter-toggle .opt.active{background:var(--a);color:#fff;border-color:var(--a)}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.4);z-index:1000;display:flex;align-items:center;justify-content:center}
.modal-content{background:#fff;border-radius:12px;padding:24px;max-width:800px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 8px 30px rgba(0,0,0,.15)}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.modal-header h3{font-size:16px;font-weight:600}
.modal-close{font-size:22px;cursor:pointer;opacity:.5;border:none;background:none}
.modal-close:hover{opacity:1}
.modal-table{width:100%;border-collapse:collapse;font-size:13px}
.modal-table th{text-align:left;padding:8px 10px;border-bottom:2px solid var(--b);font-weight:600;font-size:11px;color:var(--t2)}
.modal-table td{padding:8px 10px;border-bottom:1px solid var(--b)}
.modal-table tr{cursor:pointer;transition:background .1s}
.modal-table tr:hover{background:#f0f0f2}
</style>
</head>
<body>
<div class="header">
  <h1>网络安全 Agent · 管理后台</h1>
  <div>
    <span class="status-dot" id="connDot"></span>
    <span id="connStatus" style="font-size:12px;color:var(--t2);margin-right:12px;">连接中...</span>
    <span class="badge">实时看板</span>
  </div>
</div>
<div class="layout">
  <div class="sidebar">
    <div class="sidebar-header">
      <input id="searchInput" type="text" placeholder="搜索对话..." oninput="filterConversations()">
      <div class="cat-filter-bar" style="display:flex;gap:4px;margin:6px 0;flex-wrap:wrap;align-items:center">
        <span style="font-size:10px;font-weight:600;color:var(--t2);margin-right:2px">分组:</span>
        <span class="cat-filter opt active" data-cat="user" onclick="setConvCatFilter('user')">用户</span>
        <span class="cat-filter opt" data-cat="prompt_test" onclick="setConvCatFilter('prompt_test')">Prompt Test</span>
        <span class="cat-filter opt" data-cat="all" onclick="setConvCatFilter('all')">全部</span>
        <span style="width:1px;height:16px;background:var(--b);margin:0 4px"></span>
        <span style="font-size:10px;font-weight:600;color:var(--t2);margin-right:2px">状态:</span>
        <span class="del-filter opt active" data-val="all" onclick="setDeletedFilter('all')">全部</span>
        <span class="del-filter opt" data-val="active" onclick="setDeletedFilter('active')">未删</span>
        <span class="del-filter opt" data-val="deleted" onclick="setDeletedFilter('deleted')">已删</span>
      </div>
      <div class="jb-filter-bar" style="display:flex;gap:4px;margin:4px 0 6px;flex-wrap:wrap">
        <span class="jb-filter opt active" data-jb="all" onclick="setConvJailbreakFilter('all')">正常</span>
        <span class="jb-filter opt" data-jb="pending" onclick="setConvJailbreakFilter('pending')" style="color:var(--r)">🔴 越狱</span>
      </div>
      <div class="stats" id="sidebarStats">加载中...</div>
    </div>
    <div class="active-panel" id="activePanel">
      <div class="active-title"><span>正在进行</span><span id="activeCount">0</span></div>
      <div id="activeList"></div>
    </div>
    <div class="sidebar-list" id="convList"></div>
  </div>
  <div class="main" id="mainPanel">
    <div class="tab-bar" id="tabBar">
      <div class="tab-item active" data-tab="detail" onclick="switchTab('detail')">对话详情</div>
      <div class="tab-item" data-tab="overview" onclick="switchTab('overview')">概览看板</div>
      <div class="tab-item" data-tab="performance" onclick="switchTab('performance')">性能看板</div>
      <div class="tab-item" data-tab="prompt" onclick="switchTab('prompt')">Prompt 评测</div>
    </div>
    <div class="tab-content active" id="tabDetail">
      <div class="empty-state" id="detailEmpty">
        <span class="icon" style="font-size:48px;opacity:.3">&#x1F4AC;</span>
        <p style="margin-top:8px">选择一个对话查看详情</p>
      </div>
      <div id="detailContent" style="display:none"></div>
    </div>
    <div class="tab-content" id="tabOverview">
      <div class="filter-bar" style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
        <span class="filter-label" style="font-size:12px;font-weight:600;color:var(--t2);line-height:30px">维度过滤:</span>
        <span class="cat-filter opt active" data-cat="all" onclick="setDashboardCategory('all')">全部</span>
        <span class="cat-filter opt" data-cat="user" onclick="setDashboardCategory('user')">用户</span>
        <span class="cat-filter opt" data-cat="prompt_test" onclick="setDashboardCategory('prompt_test')">Prompt Test</span>
      </div>
      <div class="health-row" id="healthRow"></div>
      <div class="chart-grid" id="overviewGrid1">
        <div class="chart-card"><div class="chart-title">文档热度 Top5</div><div class="chart-box" id="chartDocHeat"></div></div>
        <div class="chart-card"><div class="chart-title">评分分布</div><div class="chart-box" id="chartRatingDist"></div></div>
      </div>
      <div class="chart-grid" id="overviewGrid2">
        <div class="chart-card"><div class="chart-title">评分趋势 (近30天)</div><div class="chart-box" id="chartRatingTrend"></div></div>
        <div class="chart-card"><div class="chart-title">对话活跃 (近30天)</div><div class="chart-box" id="chartActivity"></div></div>
      </div>
      <div class="chart-card full"><div class="chart-title">查询热点</div><div class="chart-box" id="chartHotspot"></div></div>
    </div>
    <div class="tab-content" id="tabPerformance">
      <div class="chart-grid" id="perfGrid1">
        <div class="chart-card"><div class="chart-title">检索质量趋势 (近30天)</div><div class="chart-box" id="chartRetrieval"></div></div>
        <div class="chart-card"><div class="chart-title">LLM 调用健康 (近30天)</div><div class="chart-box" id="chartLLM"></div></div>
      </div>
      <div class="chart-grid" id="perfGrid2">
        <div class="chart-card"><div class="chart-title">环节耗时分布 (近30天)</div><div class="chart-box" id="chartTiming"></div></div>
        <div class="chart-card"><div class="chart-title">评分-置信度散点</div><div class="chart-box" id="chartConfScatter"></div></div>
      </div>
      <div class="chart-grid" id="perfGrid3">
        <div class="chart-card"><div class="chart-title">上下文截断统计 (近30天)</div><div class="chart-box" id="chartTruncation"></div></div>
        <div class="chart-card"><div class="chart-title">低置信区间趋势 (近30天)</div><div class="chart-box" id="chartLowConf"></div></div>
      </div>
    </div>
    <!-- Prompt 评测看板 -->
    <div class="tab-content" id="tabPrompt">
      <div style="padding:20px">
        <h2 style="margin:0 0 16px">📋 Prompt 质量评测</h2>
        <div style="margin-bottom:20px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <button onclick="runPromptTest()" style="background:var(--a);color:#fff;border:none;padding:10px 24px;border-radius:8px;font-size:14px;cursor:pointer;font-family:var(--f)">▶ 运行全部测试</button>
          <button onclick="showElasticTest()" style="background:var(--b);color:var(--t);border:none;padding:10px 24px;border-radius:8px;font-size:14px;cursor:pointer;font-family:var(--f)">🔄 弹性测试</button>
          <button onclick="exportWordReport()" style="background:var(--b);color:var(--t);border:none;padding:10px 24px;border-radius:8px;font-size:14px;cursor:pointer;font-family:var(--f)">📄 导出 Word 报告</button>
          <button onclick="toggleSystemPrompt()" style="background:var(--b);color:var(--t);border:none;padding:10px 24px;border-radius:8px;font-size:14px;cursor:pointer;font-family:var(--f)">📝 System Prompt</button>
          <span id="promptTestStatus" style="margin-left:12px;color:var(--t2);font-size:13px"></span>
        </div>
        <!-- System Prompt 显示区域（只读） -->
        <div id="systemPromptPanel" style="display:none;margin-bottom:20px">
          <div class="chart-card">
            <div class="chart-title">📝 当前 System Prompt（只读）</div>
            <pre id="systemPromptContent" style="background:var(--b);padding:16px;border-radius:8px;font-size:12px;line-height:1.6;max-height:400px;overflow:auto;white-space:pre-wrap;word-break:break-word;margin:0;font-family:monospace;color:var(--t)"></pre>
          </div>
        </div>
        <div id="promptTestResult" style="display:none">
          <!-- 总览卡片 -->
          <div class="chart-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px">
            <div class="chart-card" style="text-align:center">
              <div class="chart-title" style="font-size:14px">加权总分</div>
              <div id="promptWeightedScore" style="font-size:36px;font-weight:700;color:var(--a);margin-top:8px">--</div>
            </div>
            <div class="chart-card" style="text-align:center">
              <div class="chart-title" style="font-size:14px">总体得分</div>
              <div id="promptOverallScore" style="font-size:36px;font-weight:700;color:var(--a);margin-top:8px">--</div>
            </div>
            <div class="chart-card" style="text-align:center">
              <div class="chart-title" style="font-size:14px">通过率</div>
              <div id="promptPassRate" style="font-size:36px;font-weight:700;color:var(--a);margin-top:8px">--</div>
            </div>
            <div class="chart-card" style="text-align:center">
              <div class="chart-title" style="font-size:14px">测试总数</div>
              <div id="promptTotal" style="font-size:36px;font-weight:700;color:var(--a);margin-top:8px">--</div>
            </div>
          </div>
          <!-- 版本管理 -->
          <div class="chart-grid" style="grid-template-columns:1fr 1fr;margin-bottom:20px">
            <div class="chart-card">
              <div class="chart-title">📦 版本管理</div>
              <div id="promptVersions"></div>
            </div>
            <div class="chart-card">
              <div class="chart-title">📊 维度贡献度</div>
              <div class="chart-box" id="promptContributionChart"></div>
            </div>
          </div>
          <!-- 维度雷达图 -->
          <div class="chart-grid" style="grid-template-columns:1fr 1fr;margin-bottom:20px">
            <div class="chart-card">
              <div class="chart-title">各维度得分</div>
              <div class="chart-box" id="promptRadarChart"></div>
            </div>
            <div class="chart-card">
              <div class="chart-title">测试用例详情</div>
              <div id="promptTestCases"></div>
            </div>
          </div>
          <!-- 历史趋势 -->
          <div class="chart-grid" style="grid-template-columns:1fr;margin-bottom:20px">
            <div class="chart-card">
              <div class="chart-title">历史评测趋势</div>
              <div class="chart-box" id="promptHistoryChart"></div>
            </div>
          </div>
          <!-- 弹性测试 -->
          <div class="chart-grid" style="grid-template-columns:1fr;margin-bottom:20px;display:none" id="elasticTestPanel">
            <div class="chart-card">
              <div class="chart-title">🔄 弹性测试 — 同一问题的不同表达方式</div>
              <div id="elasticTestResults"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>

<!-- 测试用例详情弹窗 -->
<div class="token-modal" id="caseDetailModal" style="display:none;z-index:10000">
  <div class="token-modal-bg" onclick="closeCaseDetail()"></div>
  <div class="token-modal-card" style="width:600px;max-height:80vh;overflow-y:auto">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <h2 id="caseDetailTitle" style="margin:0;font-size:16px"></h2>
      <button onclick="closeCaseDetail()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--t2)">×</button>
    </div>
    <div id="caseDetailBody" style="font-size:13px;line-height:1.6"></div>
  </div>
</div>

<!-- Token 登录弹窗 -->
<div class="token-modal" id="tokenModal" style="display:none">
  <div class="token-modal-bg"></div>
  <div class="token-modal-card">
    <h2>🔐 管理后台认证</h2>
    <p style="color:var(--t2);font-size:13px;margin:8px 0 16px">请输入管理员 Token 以访问管理后台</p>
    <input type="password" id="tokenInput" placeholder="请输入 X-Admin-Token" style="width:100%;padding:10px 14px;border:1px solid var(--b);border-radius:8px;font-size:14px;font-family:var(--f);outline:none;box-sizing:border-box">
    <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end">
      <button onclick="saveToken()" style="background:var(--a);color:#fff;border:none;padding:8px 24px;border-radius:8px;font-size:14px;cursor:pointer;font-family:var(--f)">确认</button>
    </div>
    <div id="tokenError" style="color:var(--r);font-size:12px;margin-top:8px;display:none">Token 无效，请重试</div>
  </div>
</div>

<style>
.token-modal{position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;display:flex;align-items:center;justify-content:center}
.token-modal-bg{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.4)}
.token-modal-card{position:relative;background:var(--card);border-radius:16px;padding:32px;width:360px;max-width:90vw;box-shadow:0 8px 40px rgba(0,0,0,.15)}
</style>

<script>
// ---- Token 管理 ----
function getToken() {
  return localStorage.getItem('admin_token') || '';
}

function saveToken() {
  const token = document.getElementById('tokenInput').value.trim();
  if (!token) {
    document.getElementById('tokenError').style.display = 'block';
    document.getElementById('tokenError').textContent = 'Token 不能为空';
    return;
  }
  // HTTP Headers 只支持 ASCII，拒绝非 ASCII 字符
  if (/[^\x00-\x7F]/.test(token)) {
    document.getElementById('tokenError').style.display = 'block';
    document.getElementById('tokenError').textContent = 'Token 只能包含英文字母、数字和符号';
    return;
  }
  localStorage.setItem('admin_token', token);
  document.getElementById('tokenModal').style.display = 'none';
  document.getElementById('tokenError').style.display = 'none';
  // 重新加载数据
  connectSSE();
  fetchConversations();
}

function showTokenModal() {
  document.getElementById('tokenModal').style.display = 'flex';
  document.getElementById('tokenInput').value = '';
  document.getElementById('tokenError').style.display = 'none';
  document.getElementById('tokenInput').focus();
}

// 按回车键提交
document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('tokenInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') saveToken();
  });
  // 从 URL 查询参数读取 token（如 ?token=xxx）
  var urlParams = new URLSearchParams(window.location.search);
  var urlToken = urlParams.get('token');
  if (urlToken && !getToken()) {
    localStorage.setItem('admin_token', urlToken);
    window.history.replaceState({}, '', window.location.pathname); // 清除 URL 中的 token
  }
  // 检查是否有 Token
  if (!getToken()) {
    showTokenModal();
  } else {
    // Token 已存在，正常启动
    connectSSE();
    fetchConversations();
  }
});

// ---- 覆盖 fetch：自动注入 X-Admin-Token ----
const _origFetch = window.fetch;
window.fetch = function(input, init) {
  init = init || {};
  var token = getToken();
  if (token) {
    // HTTP Headers 只支持 ASCII，拒绝非 ASCII 字符
    if (/[^\x00-\x7F]/.test(token)) {
      console.error('Admin Token 包含非 ASCII 字符，已清除');
      localStorage.removeItem('admin_token');
      showTokenModal();
      return _origFetch(input, init);
    }
    try {
      if (init.headers instanceof Headers) {
        init.headers.set('X-Admin-Token', token);
      } else {
        init.headers = init.headers || {};
        init.headers['X-Admin-Token'] = token;
      }
    } catch(e) {
      console.error('设置 X-Admin-Token 失败:', e);
    }
  }
  return _origFetch(input, init).then(function(resp) {
    if (resp.status === 403) {
      localStorage.removeItem('admin_token');
      showTokenModal();
    }
    return resp;
  });
};

let conversations = [];
let currentConvId = null;
let activeConversations = {};
let lastConvCount = 0;
let deletedFilter = 'all';
// 默认折叠昨天及更早的对话组，只展开今天的
let collapsedGroups = { '昨天': true, '本周': true, '本月': true, '更早': true };

function showToast(msg, cls) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show' + (cls ? ' ' + cls : '');
  setTimeout(() => t.classList.remove('show'), 3000);
}

function escHtml(s) {
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

function confLabel(c) {
  if (c >= 0.9) return 'high';
  if (c >= 0.7) return 'medium';
  return 'low';
}

function confText(c) {
  if (c >= 0.9) return '高';
  if (c >= 0.7) return '中';
  return '低';
}

function formatTime(ts) {
  return new Date(ts).toLocaleString('zh-CN', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

function getDatePeriod(dateStr) {
  const d = new Date(dateStr);
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);
  const weekStart = new Date(today);
  weekStart.setDate(weekStart.getDate() - today.getDay());
  const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);

  if (d >= today) return '今天';
  if (d >= yesterday) return '昨天';
  if (d >= weekStart) return '本周';
  if (d >= monthStart) return '本月';
  return '更早';
}

function getPeriodOrder(p) {
  return {'今天':0,'昨天':1,'本周':2,'本月':3,'更早':4}[p] || 99;
}

function setDeletedFilter(val) {
  deletedFilter = val;
  document.querySelectorAll('.del-filter').forEach(el => {
    el.classList.toggle('active', el.dataset.val === val);
  });
  renderConversations();
}

function setConvCatFilter(cat) {
  _convCatFilter = cat;
  document.querySelectorAll('.cat-filter-bar > .cat-filter').forEach(el => {
    el.classList.toggle('active', el.dataset.cat === cat);
  });
  renderConversations();
}

function setConvJailbreakFilter(jb) {
  _convJailbreakFilter = jb;
  document.querySelectorAll('.jb-filter-bar .opt').forEach(el => {
    el.classList.toggle('active', el.dataset.jb === jb);
  });
  fetchConversations();  // 重新请求 backend
}

// ===== SSE 实时连接 =====
function connectSSE() {
  const dot = document.getElementById('connDot');
  const status = document.getElementById('connStatus');
  dot.className = 'status-dot dead';
  status.textContent = '连接中...';

  const es = new EventSource('/api/admin/stream');
  let reconnectTimer = null;

  es.addEventListener('init', e => {
    const data = JSON.parse(e.data);
    conversations = data.conversations || [];
    activeConversations = {};
    (data.active || []).forEach(a => { activeConversations[a.conv_id] = a; });
    lastConvCount = conversations.length;
    renderConversations();
    renderActivePanel();
    dot.className = 'status-dot live';
    status.textContent = '已连接';
    const catCounts = {};
    (data.conversations || []).forEach(c => { const cat = c.category || 'user'; catCounts[cat] = (catCounts[cat] || 0) + 1; });
    const catLabels = {'user':'用户','prompt_test':'Prompt Test'};
    const cats = Object.entries(catCounts).map(([k,v]) => `${catLabels[k]||k} ${v}`).join(' · ');
    document.getElementById('sidebarStats').textContent = `共 ${conversations.length} 个对话 · ${cats} · ${data.subscribers} 个监控`;
  });

  es.addEventListener('conversation_updated', e => {
    const data = JSON.parse(e.data);
    // Reload conversations list
    fetchConversations();
  });

  es.addEventListener('active_updated', e => {
    const data = JSON.parse(e.data);
    if (data.conv_id) {
      if (!activeConversations[data.conv_id]) {
        activeConversations[data.conv_id] = {};
      }
      Object.assign(activeConversations[data.conv_id], data);
      renderActivePanel();
    }
  });

  es.addEventListener('active_removed', e => {
    const data = JSON.parse(e.data);
    delete activeConversations[data.conv_id];
    renderActivePanel();
  });

  es.addEventListener('heartbeat', () => {});

  es.onerror = () => {
    dot.className = 'status-dot dead';
    status.textContent = '连接断开，正在重连...';
    if (reconnectTimer) clearTimeout(reconnectTimer);
    reconnectTimer = setTimeout(() => connectSSE(), 3000);
    es.close();
  };
}

let _convCatFilter = 'user';    // 'all'|'user'|'prompt_test'
let _convJailbreakFilter = 'all'; // 'all'|'pending'|'clean'

async function fetchConversations() {
  try {
    const params = new URLSearchParams({include_deleted: 'true', include_test: 'true'});
    if (_convJailbreakFilter !== 'all') params.set('jailbreak', _convJailbreakFilter);
    const resp = await fetch('/api/conversations?' + params.toString());
    const data = await resp.json();
    conversations = Array.isArray(data) ? data : (data.conversations || []);
    renderConversations();
    const totalJb = conversations.filter(c => c.jailbreak_status === 'pending').length;
    document.getElementById('sidebarStats').textContent = `共 ${conversations.length} 个对话 · 越狱 ${totalJb}`;

    // 新增对话通知
    if (conversations.length > lastConvCount) {
      const newCount = conversations.length - lastConvCount;
      showToast(`新增 ${newCount} 个对话`, 'new-conv');
    }
    lastConvCount = conversations.length;

    if (currentConvId) {
      const stillExists = conversations.find(c => c.id === currentConvId);
      if (!stillExists) {
        currentConvId = null;
        document.getElementById('mainPanel').innerHTML = '<div class="empty-state"><div class="hint"><span class="icon">&#x1F4AC;</span>选择一个对话查看详情</div></div>';
        document.getElementById('mainPanel').classList.add('empty');
      }
    }
  } catch (e) {
    console.error('加载对话列表失败:', e);
  }
}

function filterConversations() {
  renderConversations();
}

// ---- 辅助函数 ----
const categoryLabel = (cat) => {
  const m = {'user':'用户','prompt_test':'Prompt Test'};
  return m[cat] || cat;
};
const categoryColor = (cat) => {
  const m = {'user':'color:#3498db','prompt_test':'color:var(--y)'};
  return m[cat] || '';
};
const jbStatusColor = (s) => {
  const m = {'pending':'color:var(--r);background:#fff0f0','downloaded':'color:#b8860b;background:#fffde7','false_alarm':'color:#2e7d32;background:#e8f5e9','handled':'color:#2e7d32;background:#e8f5e9'};
  return m[s] || '';
};
const jbStatusLabel = (s) => {
  const m = {'pending':'待处理','downloaded':'已下载','false_alarm':'已误报','handled':'已处理'};
  return m[s] || '';
};

// ---- 对话列表渲染 ----
function renderConversations() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  let filtered = conversations;
  // 分类过滤
  if (_convCatFilter !== 'all') filtered = filtered.filter(c => (c.category || 'user') === _convCatFilter);
  // 删除过滤
  if (deletedFilter === 'active') filtered = filtered.filter(c => !c.deleted);
  else if (deletedFilter === 'deleted') filtered = filtered.filter(c => c.deleted);
  // 搜索过滤
  if (q) filtered = filtered.filter(c => c.title.toLowerCase().includes(q));

  const list = document.getElementById('convList');
  if (filtered.length === 0) {
    list.innerHTML = '<div class="empty-state">无匹配对话</div>';
    return;
  }

  // 分组：越狱对话独立到越狱区，其余按时间段
  const jbItems = filtered.filter(c => c.jailbreak_status === 'pending' && c.jailbreak_reason);
  const normalItems = filtered.filter(c => !(c.jailbreak_status === 'pending' && c.jailbreak_reason));

  const groups = {};
  for (const c of normalItems) {
    const period = getDatePeriod(c.updated_at);
    if (!groups[period]) groups[period] = [];
    groups[period].push(c);
  }

  const sortedPeriods = Object.keys(groups).sort((a,b) => getPeriodOrder(a) - getPeriodOrder(b));
  const hasSearch = q.length > 0;

  let html = '';

  // 越狱区
  if (jbItems.length > 0) {
    html += `
      <div style="margin-bottom:6px">
        <div class="group-header" style="color:var(--r);font-weight:700">
          <span><span class="arrow">▾</span> 🔴 越狱对话</span>
          <span>${jbItems.length}</span>
        </div>
        <div class="group-items">
          ${jbItems.map(c => {
            const dt = new Date(c.updated_at).toLocaleString('zh-CN', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});
            const a = c.id === currentConvId ? 'active' : '';
            const delCls = c.deleted ? 'deleted' : '';
            const catBadge = c.category ? `<span style="${categoryColor(c.category)};font-size:10px;font-weight:600;margin-left:4px">${categoryLabel(c.category)}</span>` : '';
            return `<div class="conv-item ${a} ${delCls}" style="border-left:3px solid var(--r)" onclick="selectConversation('${c.id}')">
              <div class="title" style="color:var(--r)">🔴 越狱 ${escHtml(c.title)}${catBadge}</div>
              <div class="meta"><span>${dt}</span><span class="dot">&#x25CF;</span><span>${c.id.slice(0,8)}</span></div>
            </div>`;
          }).join('')}
        </div>
      </div>`;
  }

  // 正常分组区
  html += sortedPeriods.map(period => {
    const items = groups[period];
    const groupKey = period;
    const isCollapsed = collapsedGroups[groupKey] && !hasSearch;
    const arrowCls = isCollapsed ? 'arrow collapsed' : 'arrow';
    const itemsCls = isCollapsed ? 'group-items collapsed' : 'group-items';

    return `
      <div>
        <div class="group-header" onclick="toggleGroup('${groupKey}')">
          <span><span class="${arrowCls}">▾</span> ${period}</span>
          <span>${items.length}</span>
        </div>
        <div class="${itemsCls}">
          ${items.map(c => {
            const dt = new Date(c.updated_at).toLocaleString('zh-CN', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});
            const a = c.id === currentConvId ? 'active' : '';
            const isActive = activeConversations[c.id] ? ' ⏳' : '';
            const delCls = c.deleted ? 'deleted' : '';
            const delBadge = c.deleted ? '<span class="deleted-badge">已删除</span>' : '';
            const catBadge = c.category ? `<span style="${categoryColor(c.category)};font-size:10px;font-weight:600;margin-left:4px">${categoryLabel(c.category)}</span>` : '';
            const jbBadge = c.jailbreak_status ? `<span style="font-size:9px;padding:1px 5px;border-radius:6px;margin-left:4px;${jbStatusColor(c.jailbreak_status)}">${jbStatusLabel(c.jailbreak_status)}</span>` : '';
            return `<div class="conv-item ${a} ${delCls}" onclick="selectConversation('${c.id}')">
              <div class="title">${escHtml(c.title)}${catBadge}${jbBadge}${isActive}${delBadge}</div>
              <div class="meta"><span>${dt}</span><span class="dot">&#x25CF;</span><span>${c.id.slice(0,8)}</span></div>
            </div>`;
          }).join('')}
        </div>
      </div>`;
  }).join('');

  list.innerHTML = html;
}

function toggleGroup(key) {
  collapsedGroups[key] = !collapsedGroups[key];
  renderConversations();
}

async function downloadJailbreakReport(convId) {
  try {
    showToast('正在生成报告...');
    const resp = await fetch(`/api/conversations/${convId}/jailbreak-report`);
    if (!resp.ok) { showToast('生成报告失败', 'error'); return; }
    const blob = await resp.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const now = new Date();
    const pad = n => String(n).padStart(2,'0');
    const ts = `${pad(now.getFullYear()%100)}-${pad(now.getMonth()+1)}-${pad(now.getDate())}-${pad(now.getHours())}-${pad(now.getMinutes())}`;
    a.download = `越狱报告_${convId.slice(0,8)}_${ts}.doc`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  } catch(e) {
    showToast('下载失败: ' + e.message, 'error');
  }
}

async function updateJailbreakStatus(convId, status) {
  try {
    await fetch(`/api/conversations/${convId}/jailbreak-status`, {
      method: 'PUT', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({status}),
    });
    const labels = {'false_alarm':'已标记为误报','handled':'已标记为已处理'};
    showToast(labels[status] || '状态已更新');
    // 如果当前越狱过滤条件只看 pending，更新后对话不再满足，自动切回全部
    if (_convJailbreakFilter === 'pending') {
      setConvJailbreakFilter('all');
    } else {
      fetchConversations();
    }
    selectConversation(convId);
  } catch(e) {
    showToast('操作失败: ' + e.message, 'error');
  }
}

function renderActivePanel() {
  const keys = Object.keys(activeConversations);
  document.getElementById('activeCount').textContent = keys.length;
  const list = document.getElementById('activeList');
  if (keys.length === 0) {
    list.innerHTML = '<div style="font-size:12px;color:#bbb;padding:4px 0">无进行中对话</div>';
    return;
  }
  list.innerHTML = keys.map(id => {
    const a = activeConversations[id];
    const title = a.title || id.slice(0,8);
    const stage = a.stage || '...';
    const stageLabels = {'retrieving':'检索中','reasoning':'推理中','generating':'生成中','done':'完成'};
    const stageText = stageLabels[stage] || stage;
    return `<div class="active-item">
      <span class="ai-title" title="${escHtml(title)}">${escHtml(title)}</span>
      <span class="ai-stage">${stageText}</span>
    </div>`;
  }).join('');
}

async function selectConversation(convId) {
  currentConvId = convId;
  renderConversations();
  const panel = document.getElementById('mainPanel');
  panel.classList.remove('empty');
  panel.innerHTML = '<div style="padding:40px;text-align:center;color:var(--t2)">加载中...</div>';

  try {
    const [detailResp, statsResp] = await Promise.all([
      fetch(`/api/conversations/detail?conv_id=${convId}`),
      fetch(`/api/conversations/stats?conv_id=${convId}`)
    ]);
    const detail = await detailResp.json();
    const stats = await statsResp.json();

    const dt = new Date(detail.updated_at).toLocaleString('zh-CN');

    let confHtml = '';
    if (stats.confidence_distribution) {
      const labels = {'高':'green','中':'orange','低':'red'};
      for (const [k,v] of Object.entries(stats.confidence_distribution)) {
        const cls = labels[k] || '';
        confHtml += `<div class="stat-card"><span class="num ${cls}">${v}</span><span class="label">${k}置信度</span></div>`;
      }
    }

    const isDeleted = detail.deleted;
    const catDetail = detail.category ? ` <span style="font-size:11px;font-weight:600;color:${detail.category==='user'?'#3498db':'var(--y)'}">[${categoryLabel(detail.category)}]</span>` : '';
    const jbStatus = detail.jailbreak_status;
    const jbReason = detail.jailbreak_reason || '';
    let jbBarHtml = '';
    if (jbStatus === 'pending') {
      jbBarHtml = `<div style="background:#fff0f0;border:1px solid var(--r);border-radius:8px;padding:12px 16px;margin-bottom:12px">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="color:var(--r);font-weight:700;font-size:14px">🔴 越狱检测</span>
          <span style="font-size:13px;color:#333">${escHtml(jbReason)}</span>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
          <button class="jb-btn" onclick="downloadJailbreakReport('${detail.id}')" style="padding:4px 12px;border:1px solid var(--r);border-radius:6px;background:#fff;color:var(--r);cursor:pointer;font-size:12px">📄 下载报告</button>
          <button class="jb-btn" onclick="updateJailbreakStatus('${detail.id}','false_alarm')" style="padding:4px 12px;border:1px solid #e67e22;border-radius:6px;background:#fff;color:#e67e22;cursor:pointer;font-size:12px">❌ 误报</button>
          <button class="jb-btn" onclick="updateJailbreakStatus('${detail.id}','handled')" style="padding:4px 12px;border:1px solid #2e7d32;border-radius:6px;background:#fff;color:#2e7d32;cursor:pointer;font-size:12px">✅ 已处理</button>
        </div>
      </div>`;
    } else if (jbStatus === 'false_alarm' || jbStatus === 'handled') {
      const lbl = jbStatus === 'false_alarm' ? '误报' : '已处理';
      jbBarHtml = `<div style="background:#e8f5e9;border:1px solid #2e7d32;border-radius:8px;padding:8px 16px;margin-bottom:12px">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="color:#2e7d32;font-weight:600">🟢 ${lbl}</span>
          <span style="font-size:12px;color:#666">${escHtml(jbReason)}</span>
          <span style="margin-left:auto"><button class="jb-btn" onclick="downloadJailbreakReport('${detail.id}')" style="padding:4px 12px;border:1px solid #2e7d32;border-radius:6px;background:#fff;color:#2e7d32;cursor:pointer;font-size:12px">📄 下载报告</button></span>
        </div>
      </div>`;
    }
    let html = `<div class="conv-header">
      <h2>${escHtml(detail.title)}${catDetail}${isDeleted ? ' <span style="font-size:13px;color:var(--r)">(已删除)</span>' : ''}</h2>
      ${jbBarHtml}
      <div class="meta"><span>ID: ${detail.id}</span><span>${dt}</span><span>${detail.stats.rounds} 轮对话</span><span>${stats.total_sources} 条来源引用</span>
        ${isDeleted ? `<span style="color:var(--r);cursor:pointer;text-decoration:underline" onclick="if(confirm('确认物理删除？将不可恢复！')){fetch('/api/conversations/${detail.id}/hard',{method:'DELETE'}).then(()=>{showToast('已物理删除');fetchConversations();document.getElementById('mainPanel').classList.add('empty');document.getElementById('mainPanel').innerHTML='<div class=\\'empty-state\\'><div class=\\'hint\\'><span class=\\'icon\\'>&#x1F4AC;</span>选择一个对话查看详情</div></div>';})}">物理删除</span>` : ''}
      </div>
    </div>
    <div class="stats-row">
      <div class="stat-card"><span class="num blue">${detail.stats.rounds}</span><span class="label">问答轮次</span></div>
      <div class="stat-card"><span class="num blue">${detail.messages.length}</span><span class="label">总消息数</span></div>
      <div class="stat-card"><span class="num green">${stats.unique_files}</span><span class="label">引用文件数</span></div>
      <div class="stat-card"><span class="num blue">${stats.total_sources}</span><span class="label">来源引用次数</span></div>
      ${confHtml}
    </div>`;

    if (stats.file_stats && Object.keys(stats.file_stats).length > 0) {
      const sortedFiles = Object.entries(stats.file_stats).sort((a,b) => b[1].count - a[1].count);
      html += `<div class="stats-row">`;
      for (const [fn, fs] of sortedFiles.slice(0, 6)) {
        const avgConf = fs.confidences.length > 0 ? (fs.confidences.reduce((a,b)=>a+b,0)/fs.confidences.length) : 0;
        const pct = Math.round(avgConf * 100);
        const cl = confLabel(avgConf);
        html += `<div class="stat-card" style="min-width:180px;flex:2">
          <span class="num" style="font-size:13px;font-weight:500;color:var(--t);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(fn.length > 40 ? fn.slice(0,40)+'...' : fn)}</span>
          <span class="label">引用 ${fs.count} 次 · 平均置信度 <span class="conf-badge ${cl}">${pct}%</span></span>
        </div>`;
      }
      html += `</div>`;
    }

    for (let i = 0; i < detail.messages.length; i++) {
      const msg = detail.messages[i];
      const isUser = msg.role === 'user';
      const roleLabel = isUser ? '用户提问' : 'Agent 回答';
      const roleCls = isUser ? 'user' : 'assistant';
      const time = msg.created_at ? formatTime(msg.created_at) : '';

      // 越狱消息标记：用户提问触发越狱 或 紧随其后的 Agent 回答
      let jbHighlight = false;
      if (msg.jailbreak_flagged) {
        jbHighlight = true;
      }

      const ur = msg.user_rating;
      const sr = msg.semantic_rating;
      let ratingHtml = '';
      if (ur || sr) {
        ratingHtml = `<span style="font-size:11px;color:var(--t2)">
          ${ur ? '⭐'.repeat(ur) : ''}
          ${sr ? `<span style="font-size:10px;color:#999;margin-left:4px">语义:${'⭐'.repeat(sr)}</span>` : ''}
        </span>`;
      }

      html += `<div class="msg-card${jbHighlight ? ' msg-jailbreak' : ''}">
        <div class="msg-header ${roleCls}"><span>${jbHighlight ? '🔴 ' : ''}${roleLabel} #${Math.ceil((i+1)/2)}</span><span>${ratingHtml} <span class="time" style="margin-left:8px">${time}</span></span></div>
        <div class="msg-body">${escHtml(msg.content || '(空)')}</div>`;

      if (!isUser && msg.sources && msg.sources.length > 0) {
        html += `<div class="msg-sources">
          <div class="src-title">来源文件 (${msg.sources.length} 条)</div>`;
        for (const s of msg.sources) {
          const conf = s.confidence != null ? s.confidence : 0;
          const pct = Math.round(conf * 100);
          const cl = confLabel(conf);
          const ct = confText(conf);
          const fn = s.file_name || '未知文件';
          const sec = s.section ? ` / ${s.section}` : '';
          html += `<div class="src-item">
            <span class="file-name" title="${escHtml(fn)}">${escHtml(fn.length > 35 ? fn.slice(0,35)+'...' : fn)}</span>
            <span class="section">${escHtml(sec)}</span>
            <div class="bar-wrap"><div class="bar-fill ${cl}" style="width:${pct}%"></div></div>
            <span class="conf-badge ${cl}">${ct} ${pct}%</span>
          </div>`;
        }
        html += `</div>`;
      } else if (!isUser) {
        html += `<div class="msg-sources"><div class="src-title" style="color:var(--t2)">无来源引用</div></div>`;
      }
      html += `</div>`;
    }

    panel.innerHTML = html;
    panel.scrollTop = 0;
  } catch (e) {
    console.error('加载对话详情失败:', e);
    document.getElementById('detailContent').innerHTML = `<div class="empty-state">加载失败: ${e.message}</div>`;
  }
}

// ===== Tab =====
let chartInstances = {};

function switchTab(name) {
  document.querySelectorAll('.tab-item').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.toggle('active', t.id === 'tab' + name.charAt(0).toUpperCase() + name.slice(1)));
  if ((name === 'overview' || name === 'performance') && !chartInstances.initialized) {
    renderDashboard();
  }
  if (name === 'detail' && currentConvId) {
    selectConversation(currentConvId);
  }
  if (name === 'prompt') {
    loadLatestPromptResult();
  }
  // 强制所有 ECharts 实例重新计算尺寸（解决 display:none 容器初始化导致变形）
  setTimeout(() => {
    for (const key in chartInstances) {
      if (key !== 'initialized' && chartInstances[key] && typeof chartInstances[key].resize === 'function') {
        chartInstances[key].resize();
      }
    }
    // Prompt 评测图表（独立变量）
    [promptRadarChart, promptHistoryChart, promptContributionChart].forEach(c => {
      if (c && typeof c.resize === 'function') c.resize();
    });
  }, 50);
}

let _dashboardCategory = 'all';

function setDashboardCategory(cat) {
  _dashboardCategory = cat;
  document.querySelectorAll('.cat-filter').forEach(el => {
    el.classList.toggle('active', el.dataset.cat === cat);
  });
  renderDashboard();
}

async function renderDashboard() {
  try {
    const [dashResp, healthResp] = await Promise.all([
      fetch('/api/stats/dashboard?category=' + _dashboardCategory),
      fetch('/api/stats/health'),
    ]);
    if (!dashResp.ok) {
      document.getElementById('healthRow').innerHTML = '<div class="health-card" style="grid-column:1/-1;color:var(--r)">看板数据加载失败 (' + dashResp.status + ')，请检查 Token 是否有效</div>';
      return;
    }
    const dash = await dashResp.json();
    const health = await healthResp.json();
    renderHealth(health);
    renderOverviewCharts(dash);
    renderPerfCharts(dash);
    chartInstances.initialized = true;
  } catch (e) {
    console.error('看板加载失败:', e);
    document.getElementById('healthRow').innerHTML = '<div class="health-card" style="grid-column:1/-1;color:var(--r)">看板加载失败: ' + e.message + '</div>';
  }
}

function renderHealth(h) {
  const hh = h || {};
  const uptime = hh.uptime_seconds ? Math.floor(hh.uptime_seconds / 60) + 'm' : '-';
  document.getElementById('healthRow').innerHTML = `
    <div class="health-card"><span class="hnum green">${hh.llm_provider || '-'}</span><span class="hlbl">LLM 提供商</span></div>
    <div class="health-card"><span class="hnum blue">${hh.llm_model || '-'}</span><span class="hlbl">当前模型</span></div>
    <div class="health-card"><span class="hnum ${hh.faiss_ready ? 'green' : 'orange'}">${hh.faiss_ready ? '✅' : '⚠️'}</span><span class="hlbl">FAISS 索引</span></div>
    <div class="health-card"><span class="hnum ${hh.chroma_ready ? 'green' : 'orange'}">${hh.chroma_ready ? '✅' : '⚠️'}</span><span class="hlbl">Chroma 索引</span></div>
    <div class="health-card"><span class="hnum orange">${uptime}</span><span class="hlbl">运行时长</span></div>
    <div class="health-card"><span class="hnum blue">${hh.today_queries || 0}</span><span class="hlbl">今日问答</span></div>
  `;
}

function makeChart(elemId, option) {
  const el = document.getElementById(elemId);
  if (!el) return null;
  if (chartInstances[elemId]) chartInstances[elemId].dispose();
  const chart = echarts.init(el);
  chart.setOption(option);
  chartInstances[elemId] = chart;
  window.addEventListener('resize', () => chart.resize());
  return chart;
}

function renderOverviewCharts(d) {
  const dateOpt = {axisLabel:{fontSize:11,rotate:15,margin:8}};

  makeChart('chartDocHeat', {
    title: {text: '文档热度 Top5', textStyle:{fontSize:14,fontWeight:600}}, grid:{left:10,right:30,top:36,bottom:10,containLabel:true},
    xAxis: {type:'value', axisLabel:{fontSize:11}},
    yAxis: {type:'category', data: d.doc_hotness.slice(0,5).map(x => x.file_name.length>16?x.file_name.slice(0,16)+'...':x.file_name).reverse(), axisLabel:{fontSize:11,fontWeight:500}},
    series: [{type:'bar', data: d.doc_hotness.slice(0,5).map(x=>({value:x.count,itemStyle:{color:x.avg_confidence>0.8?'#34c759':x.avg_confidence>0.6?'#ff9500':'#ff3b30'}})).reverse(),
      barMaxWidth:26,label:{show:true,position:'right',fontSize:11,formatter:p=>p.value+'次'}}],
    tooltip:{trigger:'axis',formatter:p=>p[0]?`${p[0].name}<br/>引用: ${p[0].value}次<br/>置信度: ${((d.doc_hotness.slice(0,5).reverse()[p[0].dataIndex]||{}).avg_confidence*100||0).toFixed(0)}%`:''},
  });

  const rd = d.ratings.distribution || {};
  const ratingChart = makeChart('chartRatingDist', {
    title: {text: '评分分布', textStyle:{fontSize:14,fontWeight:600}}, tooltip:{trigger:'item',formatter:'{b}: {c} ({d}%)'},
    series: [{type:'pie',radius:['35%','65%'],center:['50%','55%'],
      data:[1,2,3,4,5].map(k=>({name:k+'星',value:rd[k]||0})),
      label:{fontSize:12,formatter:'{b}\n{c}次'},itemStyle:{borderRadius:4},
      color:['#ff3b30','#ff9500','#ffcc00','#34c759','#0071e3']}],
  });
  ratingChart.on('click', function(params) {
    const star = params.name.charAt(0);
    openDrillDownModal('rating', star, `${star}星评分问答`);
  });

  const rt = d.ratings.trend || [];
  makeChart('chartRatingTrend', {
    title: {text: '评分趋势 (近30天)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:42,right:20,top:36,bottom:28},
    xAxis: {type:'category', data:rt.map(x=>x.date.slice(5)), ...dateOpt},
    yAxis: {type:'value',min:2,max:5,axisLabel:{fontSize:11}},
    series: [{type:'line',data:rt.map(x=>x.avg_rating),smooth:true,lineStyle:{width:2.5},symbol:'circle',symbolSize:6,areaStyle:{opacity:.15}}],
    tooltip:{trigger:'axis'},
  });

  const act = d.activity || [];
  makeChart('chartActivity', {
    title: {text: '对话活跃 (近30天)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:42,right:20,top:36,bottom:28},
    xAxis: {type:'category', data:act.map(x=>x.date.slice(5)), ...dateOpt},
    yAxis: {type:'value',axisLabel:{fontSize:11}},
    series: [{type:'bar',data:act.map(x=>x.total_queries),barMaxWidth:18,itemStyle:{color:'#0071e3',borderRadius:[4,4,0,0]},label:{show:true,fontSize:10,position:'top'}}],
    tooltip:{trigger:'axis'},
  });

  const hs = d.query_hotspots || [];
  const hotspotChart = makeChart('chartHotspot', {
    title: {text: '查询热点', textStyle:{fontSize:14,fontWeight:600}}, tooltip:{trigger:'item',formatter:p=>`${p.name}: ${p.value}次`},
    series: [{type:'wordCloud',shape:'circle',sizeRange:[14,44],rotationRange:[-20,20],gridSize:6,
      textStyle:{fontWeight:'bold',color:()=>['#0071e3','#34c759','#ff9500','#ff3b30','#5856d6','#af52de'][Math.floor(Math.random()*6)]},
      data:hs.slice(0,40).map(x=>({name:x.keyword,value:x.count}))}],
  });
  hotspotChart.on('click', function(params) {
    openDrillDownModal('keyword', params.name, `包含"${params.name}"的问答`);
  });
}

function renderPerfCharts(d) {
  const dateOpt = {axisLabel:{fontSize:11,rotate:15,margin:8}};
  const rt = d.retrieval_trends || [];

  makeChart('chartRetrieval', {
    title: {text: '检索质量趋势 (近30天)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:42,right:56,top:36,bottom:28},
    xAxis: {type:'category',data:rt.map(x=>x.date.slice(5)),...dateOpt},
    yAxis: [{type:'value',name:'耗时(秒)',axisLabel:{fontSize:11}},{type:'value',name:'召回(条)',axisLabel:{fontSize:11}}],
    series: [
      {name:'平均耗时',type:'line',data:rt.map(x=>x.avg_total_time),smooth:true,lineStyle:{width:2.5},symbol:'circle',symbolSize:6,yAxisIndex:0},
      {name:'平均召回',type:'line',data:rt.map(x=>x.avg_returned_count),smooth:true,lineStyle:{width:2.5,color:'#34c759'},symbol:'diamond',symbolSize:6,yAxisIndex:1,itemStyle:{color:'#34c759'}},
    ],
    tooltip:{trigger:'axis'},legend:{bottom:0,textStyle:{fontSize:11}},
  });

  const lh = d.llm_health || [];
  const llmChart = makeChart('chartLLM', {
    title: {text: 'LLM 调用健康 (近30天)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:42,right:20,top:36,bottom:28},
    xAxis: {type:'category',data:lh.map(x=>x.date.slice(5)),...dateOpt},
    yAxis: {type:'value',axisLabel:{fontSize:11}},
    series: [
      {name:'成功',type:'bar',stack:'total',data:lh.map(x=>x.success_count),barMaxWidth:18,itemStyle:{color:'#34c759'}},
      {name:'失败',type:'bar',stack:'total',data:lh.map(x=>x.fail_count),barMaxWidth:18,itemStyle:{color:'#ff3b30',borderRadius:[4,4,0,0]}},
      {name:'熔断',type:'line',data:lh.map(x=>x.circuit_break_count),symbol:'diamond',symbolSize:8,lineStyle:{color:'#ff9500',width:2,type:'dashed'},itemStyle:{color:'#ff9500'}},
    ],
    tooltip:{trigger:'axis'},legend:{bottom:0,textStyle:{fontSize:11}},
  });
  llmChart.on('click', function(params) {
    if (params.seriesName === '失败' && params.value > 0) {
      const dateStr = lh[params.dataIndex].date;
      openDrillDownModal('error_date', dateStr, `${dateStr} LLM 错误详情`);
    }
  });

  const cs = d.confidence_scatter || [];
  const scatterChart = makeChart('chartConfScatter', {
    title: {text: '评分-置信度散点 (质量交叉分析)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:50,right:20,top:36,bottom:30},
    xAxis: {type:'value',name:'平均置信度',min:0,max:1,axisLabel:{fontSize:11,fontWeight:500},nameTextStyle:{fontSize:11}},
    yAxis: {type:'value',name:'用户评分',min:0,max:5,axisLabel:{fontSize:11,fontWeight:500},nameTextStyle:{fontSize:11}},
    series: [{type:'scatter',symbolSize:10,data:cs.map(x=>[x.avg_confidence,x.rating]),itemStyle:{color:'#0071e3',opacity:.7}}],
    tooltip:{trigger:'item',formatter:p=>`置信度: ${p.data[0].toFixed(2)}<br/>评分: ${p.data[1]}<br/>${cs[p.dataIndex]?.query_short||''}`},
  });
  scatterChart.on('click', function(params) {
    const idx = params.dataIndex;
    const item = cs[idx];
    if (item) {
      openDrillDownModal('scatter', String(idx), `问答详情 (置信度:${item.avg_confidence}, 评分:${item.rating})`);
    }
  });

  makeChart('chartTiming', {
    title: {text: '环节耗时分布 (近30天)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:42,right:20,top:36,bottom:28},
    xAxis: {type:'category',data:rt.map(x=>x.date.slice(5)),...dateOpt},
    yAxis: {type:'value',name:'秒',axisLabel:{fontSize:11}},
    series: [
      {name:'改写',type:'bar',stack:'time',data:rt.map(x=>x.avg_rewrite_time),barMaxWidth:18,itemStyle:{color:'#5856d6'}},
      {name:'LLM',type:'bar',stack:'time',data:rt.map(x=>x.avg_llm_time),barMaxWidth:18,itemStyle:{color:'#0071e3',borderRadius:[4,4,0,0]}},
      {name:'总计',type:'line',data:rt.map(x=>x.avg_total_time),symbol:'none',lineStyle:{width:2,color:'#ff3b30',type:'dashed'}},
    ],
    tooltip:{trigger:'axis'},legend:{bottom:0,textStyle:{fontSize:11}},
  });

  const tr = d.truncation || [];
  makeChart('chartTruncation', {
    title: {text: '上下文截断统计 (近30天)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:42,right:20,top:36,bottom:28},
    xAxis: {type:'category',data:tr.map(x=>x.date.slice(5)),...dateOpt},
    yAxis: {type:'value',axisLabel:{fontSize:11}},
    series: [{type:'bar',data:tr.map(x=>x.truncation_count),barMaxWidth:18,itemStyle:{color:'#ff9500',borderRadius:[4,4,0,0]},label:{show:true,fontSize:10,position:'top'}}],
    tooltip:{trigger:'axis'},
  });

  const dh = d.doc_hotness || [];
  const lowConf = dh.filter(x=>x.avg_confidence<0.7).slice(0,10);
  makeChart('chartLowConf', {
    title: {text: '低置信度文档 (置信度<0.7)', textStyle:{fontSize:14,fontWeight:600}},
    grid:{left:10,right:30,top:36,bottom:10,containLabel:true},
    xAxis: {type:'value',axisLabel:{fontSize:11}},
    yAxis: {type:'category',data:lowConf.map(x=>x.file_name.length>14?x.file_name.slice(0,14)+'...':x.file_name),axisLabel:{fontSize:11}},
    series: [{type:'bar',data:lowConf.map(x=>x.count),barMaxWidth:22,itemStyle:{color:'#ff3b30',borderRadius:[0,4,4,0]},label:{show:true,position:'right',fontSize:11,formatter:p=>p.value+'次'}}],
    tooltip:{trigger:'axis'},
  });

}

// Override selectConversation to fill detailContent
const _origSelect = selectConversation;
selectConversation = async function(convId) {
  currentConvId = convId;
  renderConversations();
  const detailTab = document.querySelector('.tab-item[data-tab="detail"]');
  if (detailTab && !detailTab.classList.contains('active')) {
    switchTab('detail');
  }
  document.getElementById('detailEmpty').style.display = 'none';
  const panel = document.getElementById('detailContent');
  panel.style.display = 'block';
  panel.innerHTML = '<div style="padding:40px;text-align:center;color:var(--t2)">加载中...</div>';

  try {
    const [detailResp, statsResp] = await Promise.all([
      fetch(`/api/conversations/detail?conv_id=${convId}`),
      fetch(`/api/conversations/stats?conv_id=${convId}`)
    ]);
    const detail = await detailResp.json();
    const stats = await statsResp.json();

    const dt = new Date(detail.updated_at).toLocaleString('zh-CN');

    let confHtml = '';
    if (stats.confidence_distribution) {
      const labels = {'高':'green','中':'orange','低':'red'};
      for (const [k,v] of Object.entries(stats.confidence_distribution)) {
        const cls = labels[k] || '';
        confHtml += `<div class="stat-card"><span class="num ${cls}">${v}</span><span class="label">${k}置信度</span></div>`;
      }
    }

    const isDeleted = detail.deleted;
    const catDetail = detail.category ? ` <span style="font-size:11px;font-weight:600;color:${detail.category==='user'?'#3498db':'var(--y)'}">[${categoryLabel(detail.category)}]</span>` : '';
    const jbStatus2 = detail.jailbreak_status;
    const jbReason2 = detail.jailbreak_reason || '';
    let jbBarHtml2 = '';
    if (jbStatus2 === 'pending') {
      jbBarHtml2 = `<div style="background:#fff0f0;border:1px solid var(--r);border-radius:8px;padding:12px 16px;margin-bottom:12px">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="color:var(--r);font-weight:700;font-size:14px">🔴 越狱检测</span>
          <span style="font-size:13px;color:#333">${escHtml(jbReason2)}</span>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
          <button class="jb-btn" onclick="downloadJailbreakReport('${detail.id}')" style="padding:4px 12px;border:1px solid var(--r);border-radius:6px;background:#fff;color:var(--r);cursor:pointer;font-size:12px">📄 下载报告</button>
          <button class="jb-btn" onclick="updateJailbreakStatus('${detail.id}','false_alarm')" style="padding:4px 12px;border:1px solid #e67e22;border-radius:6px;background:#fff;color:#e67e22;cursor:pointer;font-size:12px">❌ 误报</button>
          <button class="jb-btn" onclick="updateJailbreakStatus('${detail.id}','handled')" style="padding:4px 12px;border:1px solid #2e7d32;border-radius:6px;background:#fff;color:#2e7d32;cursor:pointer;font-size:12px">✅ 已处理</button>
        </div>
      </div>`;
    } else if (jbStatus2 === 'false_alarm' || jbStatus2 === 'handled') {
      const lbl = jbStatus2 === 'false_alarm' ? '误报' : '已处理';
      jbBarHtml2 = `<div style="background:#e8f5e9;border:1px solid #2e7d32;border-radius:8px;padding:8px 16px;margin-bottom:12px">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="color:#2e7d32;font-weight:600">🟢 ${lbl}</span>
          <span style="font-size:12px;color:#666">${escHtml(jbReason2)}</span>
          <span style="margin-left:auto"><button class="jb-btn" onclick="downloadJailbreakReport('${detail.id}')" style="padding:4px 12px;border:1px solid #2e7d32;border-radius:6px;background:#fff;color:#2e7d32;cursor:pointer;font-size:12px">📄 下载报告</button></span>
        </div>
      </div>`;
    }
    let html = `<div class="conv-header">
      <h2>${escHtml(detail.title)}${catDetail}${isDeleted ? ' <span style="font-size:13px;color:var(--r)">(已删除)</span>' : ''}</h2>
      ${jbBarHtml2}
      <div class="meta"><span>ID: ${detail.id}</span><span>${dt}</span><span>${detail.stats.rounds} 轮对话</span><span>${stats.total_sources} 条来源引用</span>
        ${isDeleted ? `<span style="color:var(--r);cursor:pointer;text-decoration:underline" onclick="if(confirm('确认物理删除？将不可恢复！')){fetch('/api/conversations/${detail.id}/hard',{method:'DELETE'}).then(()=>{showToast('已物理删除');fetchConversations();document.getElementById('detailContent').style.display='none';document.getElementById('detailEmpty').style.display='block';})}">物理删除</span>` : ''}
      </div>
    </div>
    <div class="stats-row">
      <div class="stat-card"><span class="num blue">${detail.stats.rounds}</span><span class="label">问答轮次</span></div>
      <div class="stat-card"><span class="num blue">${detail.messages.length}</span><span class="label">总消息数</span></div>
      <div class="stat-card"><span class="num green">${stats.unique_files}</span><span class="label">引用文件数</span></div>
      <div class="stat-card"><span class="num blue">${stats.total_sources}</span><span class="label">来源引用次数</span></div>
      ${confHtml}
    </div>`;

    if (stats.file_stats && Object.keys(stats.file_stats).length > 0) {
      const sortedFiles = Object.entries(stats.file_stats).sort((a,b) => b[1].count - a[1].count);
      html += `<div class="stats-row">`;
      for (const [fn, fs] of sortedFiles.slice(0, 6)) {
        const avgConf = fs.confidences.length > 0 ? (fs.confidences.reduce((a,b)=>a+b,0)/fs.confidences.length) : 0;
        const pct = Math.round(avgConf * 100);
        const cl = confLabel(avgConf);
        html += `<div class="stat-card" style="min-width:180px;flex:2">
          <span class="num" style="font-size:13px;font-weight:500;color:var(--t);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(fn.length > 40 ? fn.slice(0,40)+'...' : fn)}</span>
          <span class="label">引用 ${fs.count} 次 · 平均置信度 <span class="conf-badge ${cl}">${pct}%</span></span>
        </div>`;
      }
      html += `</div>`;
    }

    for (let i = 0; i < detail.messages.length; i++) {
      const msg = detail.messages[i];
      const isUser = msg.role === 'user';
      const roleLabel = isUser ? '用户提问' : 'Agent 回答';
      const roleCls = isUser ? 'user' : 'assistant';
      const time = msg.created_at ? formatTime(msg.created_at) : '';

      let jbHighlight = false;
      if (msg.jailbreak_flagged) {
        jbHighlight = true;
      }

      const ur = msg.user_rating;
      const sr = msg.semantic_rating;
      let ratingHtml = '';
      if (ur || sr) {
        ratingHtml = `<span style="font-size:11px;color:var(--t2)">
          ${ur ? '⭐'.repeat(ur) : ''}
          ${sr ? `<span style="font-size:10px;color:#999;margin-left:4px">语义:${'⭐'.repeat(sr)}</span>` : ''}
        </span>`;
      }

      html += `<div class="msg-card${jbHighlight ? ' msg-jailbreak' : ''}">
        <div class="msg-header ${roleCls}"><span>${jbHighlight ? '🔴 ' : ''}${roleLabel} #${Math.ceil((i+1)/2)}</span><span>${ratingHtml} <span class="time" style="margin-left:8px">${time}</span></span></div>
        <div class="msg-body">${escHtml(msg.content || '(空)')}</div>`;

      if (!isUser && msg.sources && msg.sources.length > 0) {
        html += `<div class="msg-sources">
          <div class="src-title">来源文件 (${msg.sources.length} 条)</div>`;
        for (const s of msg.sources) {
          const conf = s.confidence != null ? s.confidence : 0;
          const pct = Math.round(conf * 100);
          const cl = confLabel(conf);
          const ct = confText(conf);
          const fn = s.file_name || '未知文件';
          const sec = s.section ? ` / ${s.section}` : '';
          html += `<div class="src-item">
            <span class="file-name" title="${escHtml(fn)}">${escHtml(fn.length > 35 ? fn.slice(0,35)+'...' : fn)}</span>
            <span class="section">${escHtml(sec)}</span>
            <div class="bar-wrap"><div class="bar-fill ${cl}" style="width:${pct}%"></div></div>
            <span class="conf-badge ${cl}">${ct} ${pct}%</span>
          </div>`;
        }
        html += `</div>`;
      } else if (!isUser) {
        html += `<div class="msg-sources"><div class="src-title" style="color:var(--t2)">无来源引用</div></div>`;
      }
      html += `</div>`;
    }

    panel.innerHTML = html;
    panel.scrollTop = 0;
  } catch (e) {
    console.error('加载对话详情失败:', e);
    panel.innerHTML = `<div class="empty-state">加载失败: ${e.message}</div>`;
  }
};

// ===== 图表钻取模态框 =====
function openDrillDownModal(type, key, title) {
  fetch(`/api/stats/drill-down?type=${type}&key=${encodeURIComponent(key)}&category=${_dashboardCategory}`)
    .then(r => r.json())
    .then(data => {
      if (data.error) { showToast('钻取查询失败: ' + data.error); return; }
      if (!Array.isArray(data) || data.length === 0) { showToast('无匹配数据'); return; }

      let tableHtml = `<table class="modal-table">
        <thead><tr><th>对话ID</th><th>问题</th><th>详情</th><th>时间</th></tr></thead><tbody>`;

      for (const row of data) {
        const detail = row.detail || {};
        const detailStr = Object.entries(detail)
          .filter(([k]) => k !== 'created_at')
          .map(([k, v]) => `${k}=${v}`).join(', ');

        const time = detail.created_at || '';
        tableHtml += `<tr onclick="selectConversation('${row.conversation_id}')">
          <td style="font-size:11px;font-family:monospace">${row.conversation_id || ''}</td>
          <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(row.query || '')}">${escHtml(row.query || '')}</td>
          <td style="font-size:11px;color:var(--t2)">${escHtml(detailStr)}</td>
          <td style="font-size:11px;color:var(--t2);white-space:nowrap">${time}</td>
        </tr>`;
      }
      tableHtml += '</tbody></table>';

      const modal = document.createElement('div');
      modal.className = 'modal-overlay';
      modal.innerHTML = `<div class="modal-content">
        <div class="modal-header">
          <h3>${escHtml(title)} (${data.length} 条)</h3>
          <button class="modal-close" onclick="this.closest('.modal-overlay').remove()">&times;</button>
        </div>
        ${tableHtml}
      </div>`;
      modal.addEventListener('click', function(e) {
        if (e.target === this) this.remove();
      });
      document.body.appendChild(modal);
    })
    .catch(e => {
      console.error('钻取查询失败:', e);
      showToast('查询失败: ' + e.message);
    });
}

// 首次加载看板
setTimeout(() => { if (document.querySelector('.tab-item.active')?.dataset.tab !== 'detail') renderDashboard(); }, 2000);
// 每60秒刷新会话列表作为保底
setInterval(fetchConversations, 60000);
// 每5分钟刷新看板
setInterval(renderDashboard, 300000);

// 页面加载后自动加载最新 Prompt 评测结果（图表驻留）
setTimeout(loadLatestPromptResult, 1000);

// ============================================================
// Prompt 评测功能
// ============================================================
let promptRadarChart = null;
let promptHistoryChart = null;
let promptContributionChart = null;
let _promptTestResults = [];
let _promptTestSuite = null;

// 页面加载时自动取最新评测结果（图表驻留）
async function loadLatestPromptResult() {
  try {
    const resp = await fetch('/api/prompt/test/latest');
    if (!resp.ok) return;
    const report = await resp.json();
    if (report.error) return;

    // 加载测试集（用于详情弹窗显示预期要求）
    _promptTestResults = report.results || [];
    try {
      const suiteResp = await fetch('/api/prompt/test/suite');
      if (suiteResp.ok) _promptTestSuite = await suiteResp.json();
    } catch(e) {}

    const statusEl = document.getElementById('promptTestStatus');
    statusEl.textContent = `📋 上次测试 (${report.passed}/${report.total})`;
    statusEl.style.color = report.pass_rate >= 80 ? 'green' : report.pass_rate >= 60 ? 'orange' : 'red';

    document.getElementById('promptWeightedScore').textContent = (report.weighted_score || 0) + '%';
    document.getElementById('promptOverallScore').textContent = (report.overall_score || 0) + '%';
    document.getElementById('promptPassRate').textContent = (report.pass_rate || 0) + '%';
    document.getElementById('promptTotal').textContent = report.total || 0;

    if (report.dimension_scores && Object.keys(report.dimension_scores).length > 0) {
      renderPromptContribution(report.dimension_scores);
      renderPromptRadar(report.dimension_scores);
    }
    if (report.results && report.results.length > 0) {
      renderPromptTestCases(report.results);
    }
    await loadPromptHistory();
    await loadPromptVersions();

    document.getElementById('promptTestResult').style.display = 'block';
  } catch(e) {
    // 没有历史数据，不报错
  }
}

async function runPromptTest() {
  const statusEl = document.getElementById('promptTestStatus');
  const resultEl = document.getElementById('promptTestResult');
  statusEl.textContent = '⏳ 正在运行测试...';
  statusEl.style.color = 'var(--t2)';

  try {
    const resp = await fetch('/api/prompt/test/run', {method: 'POST'});
    const report = await resp.json();

    _promptTestResults = report.results || [];
    try {
      const suiteResp = await fetch('/api/prompt/test/suite');
      if (suiteResp.ok) _promptTestSuite = await suiteResp.json();
    } catch(e) {}

    statusEl.textContent = `✅ 测试完成 (${report.passed}/${report.total})`;
    statusEl.style.color = report.pass_rate >= 80 ? 'green' : report.pass_rate >= 60 ? 'orange' : 'red';

    document.getElementById('promptWeightedScore').textContent = report.weighted_score + '%';
    document.getElementById('promptOverallScore').textContent = report.overall_score + '%';
    document.getElementById('promptPassRate').textContent = report.pass_rate + '%';
    document.getElementById('promptTotal').textContent = report.total;

    renderPromptContribution(report.dimension_scores);
    renderPromptRadar(report.dimension_scores);
    renderPromptTestCases(report.results);

    await loadPromptHistory();
    await loadPromptVersions();

    resultEl.style.display = 'block';
  } catch (e) {
    statusEl.textContent = '❌ ' + e.message;
    statusEl.style.color = 'var(--r)';
    console.error('Prompt 测试失败:', e);
  }
}

function renderPromptContribution(dimScores) {
  if (promptContributionChart) promptContributionChart.dispose();

  const labels = Object.keys(dimScores);
  const values = Object.values(dimScores);

  promptContributionChart = makeChart('promptContributionChart', {
    title: {text: '各维度得分', textStyle:{fontSize:14,fontWeight:600}},
    tooltip: {trigger:'item',formatter:p=>`${p.name}: ${p.value}%`},
    xAxis: {type:'category', data:labels, axisLabel:{fontSize:11}},
    yAxis: {type:'value', min:0, max:100, name:'得分', axisLabel:{fontSize:11}},
    series: [{
      type:'bar', data:values.map(v=>v*100),
      itemStyle:{color:'#c0392b',borderRadius:[4,4,0,0]},
      label:{show:true,position:'top',fontSize:11,color:'#333'},
    }],
  });
}

function renderPromptRadar(dimScores) {
  if (promptRadarChart) promptRadarChart.dispose();
  const labels = Object.keys(dimScores);
  const values = Object.values(dimScores);

  promptRadarChart = makeChart('promptRadarChart', {
    title: {text: '各维度得分', textStyle:{fontSize:14,fontWeight:600}},
    tooltip: {trigger:'item',formatter:p=>`${p.name}: ${p.value}%`},
    radar: {
      indicator: labels.map((l,i) => ({name:l, max:100})),
      center: ['50%', '50%'],
      radius: '65%',
    },
    series: [{
      type: 'radar',
      data: [{value: values.map(v=>v*100), name:'得分', areaStyle:{color:'rgba(192,57,43,0.15)'}, lineStyle:{color:'#c0392b',width:2}, itemStyle:{color:'#c0392b'}}],
    }],
  });
}

function renderPromptTestCases(results) {
  _promptTestResults = results;
  const container = document.getElementById('promptTestCases');
  const headers = '<div class="table-header" style="display:grid;grid-template-columns:80px 1fr 1fr 60px 60px 60px;gap:8px;padding:8px 0;border-bottom:1px solid var(--b);font-size:12px;color:var(--t2);font-weight:600">' +
    '<span>ID</span><span>测试项</span><span>加权得分</span><span>状态</span><span>耗时</span></div>';
  const rows = results.map((r, idx) => {
    const pass = r.passed;
    const weighted = r.weighted_score || 0;
    return `<div class="table-row" onclick="showCaseDetail(${idx})" style="display:grid;grid-template-columns:80px 1fr 1fr 60px 60px 60px;gap:8px;padding:6px 0;border-bottom:1px solid rgba(0,0,0,0.03);font-size:12px;align-items:center;cursor:pointer" title="点击查看详情">
      <span style="color:var(--t2);font-family:monospace">${r.id}</span>
      <span style="color:var(--t);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${r.category}: ${r.query}</span>
      <span style="text-align:center;color:${weighted>=80?'green':weighted>=60?'orange':'red'}">${weighted.toFixed(0)}%</span>
      <span style="text-align:center">${pass?'✅':'❌'}</span>
      <span style="text-align:center;color:var(--t2)">${r.duration.toFixed(1)}s</span>
    </div>`;
  }).join('');
  container.innerHTML = headers + rows;
}

// ---- 测试用例详情弹窗 ----
function showCaseDetail(idx) {
  const r = _promptTestResults[idx];
  if (!r) return;

  // 从测试集中找对应的 expected 要求
  let expectedText = '';
  if (_promptTestSuite && _promptTestSuite.test_cases) {
    const tc = _promptTestSuite.test_cases.find(c => c.id === r.id);
    if (tc && tc.expected) {
      const exp = tc.expected;
      const lines = [];
      if (exp.must_contain_annotation) lines.push('✅ 必须包含来源标注');
      if (exp.must_not_contain && exp.must_not_contain.length) lines.push('🚫 禁止出现: ' + exp.must_not_contain.join(', '));
      if (exp.should_reject) lines.push('🛡️ 应拒绝/拦截该请求');
      if (exp.should_offtopic) lines.push('⚠️ 应检测为偏题');
      if (exp.should_not_ask_back) lines.push('📝 不应反问用户，直接回答');
      if (exp.should_contain && exp.should_contain.length) lines.push('📖 应包含关键词: ' + exp.should_contain.join(', '));
      if (exp.max_duration) lines.push('⏱️ 响应时间 ≤ ' + exp.max_duration + 's');
      expectedText = lines.join('<br>');
    }
  }

  // 各维度得分明细
  let scoresHtml = '';
  if (r.scores && Object.keys(r.scores).length > 0) {
    scoresHtml = Object.entries(r.scores).map(([dim, score]) => {
      const pct = (score * 100).toFixed(0);
      const color = score >= 0.8 ? 'green' : score >= 0.5 ? 'orange' : 'red';
      return `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f0f0f2">
        <span style="font-size:12px;color:var(--t)">${dim}</span>
        <span style="font-size:12px;font-weight:600;color:${color}">${pct}%</span>
      </div>`;
    }).join('');
  }

  // 细节说明
  let detailsHtml = '';
  if (r.details && Object.keys(r.details).length > 0) {
    detailsHtml = Object.entries(r.details).map(([dim, msg]) =>
      `<div style="font-size:11px;color:var(--t2);padding:2px 0"><span style="color:var(--t)">${dim}:</span> ${msg}</div>`
    ).join('');
  }

  const queryText = escHtml(r.query);
  const answerText = escHtml(r.answer_preview || '(空)');
  const avgScore = (r.avg_score * 100).toFixed(0);
  const weightedScore = (r.weighted_score || 0).toFixed(0);
  const diff = r.difficulty || 'medium';
  const diffLabels = {easy:'简单', medium:'中等', hard:'困难'};

  document.getElementById('caseDetailTitle').textContent = `📋 测试用例 #${r.id}`;

  document.getElementById('caseDetailBody').innerHTML = `
    <div style="margin-bottom:16px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
        <div class="stat-card" style="background:var(--bg)"><span class="num blue">${avgScore}%</span><span class="label">平均得分</span></div>
        <div class="stat-card" style="background:var(--bg)"><span class="num blue">${weightedScore}%</span><span class="label">加权得分</span></div>
        <div class="stat-card" style="background:var(--bg)"><span class="num" style="font-size:16px;color:var(--t)">${diffLabels[diff]||diff}</span><span class="label">难度</span></div>
        <div class="stat-card" style="background:var(--bg)"><span class="num orange">${r.duration.toFixed(1)}s</span><span class="label">耗时</span></div>
      </div>

      <div style="background:var(--bg);border-radius:8px;padding:12px;margin-bottom:12px">
        <div style="font-size:11px;font-weight:600;color:var(--t2);margin-bottom:4px">用户提问</div>
        <div style="font-size:13px;line-height:1.5;color:var(--t)">${queryText}</div>
      </div>

      <div style="background:var(--bg);border-radius:8px;padding:12px;margin-bottom:12px">
        <div style="font-size:11px;font-weight:600;color:var(--t2);margin-bottom:4px">Agent 回答（前300字）</div>
        <div style="font-size:13px;line-height:1.5;color:var(--t);max-height:200px;overflow-y:auto">${answerText}</div>
      </div>

      ${expectedText ? `<div style="background:#fff9e6;border-radius:8px;padding:12px;margin-bottom:12px">
        <div style="font-size:11px;font-weight:600;color:var(--y);margin-bottom:4px">预期要求（测试集定义）</div>
        <div style="font-size:12px;line-height:1.6;color:var(--t)">${expectedText}</div>
      </div>` : ''}

      <div style="font-size:13px;font-weight:600;color:var(--t);margin-bottom:8px">维度得分明细</div>
      ${scoresHtml || '<div style="font-size:12px;color:var(--t2)">无维度评分数据</div>'}

      ${detailsHtml ? `<div style="margin-top:12px;background:#f8f8fa;border-radius:8px;padding:12px">
        <div style="font-size:11px;font-weight:600;color:var(--t2);margin-bottom:4px">评分详情</div>
        ${detailsHtml}
      </div>` : ''}
    </div>
  `;

  document.getElementById('caseDetailModal').style.display = 'flex';
}

function closeCaseDetail() {
  document.getElementById('caseDetailModal').style.display = 'none';
}

// ---- 导出 Word 报告 ----
function exportWordReport() {
  const weightedEl = document.getElementById('promptWeightedScore');
  const overallEl = document.getElementById('promptOverallScore');
  const passRateEl = document.getElementById('promptPassRate');
  const totalEl = document.getElementById('promptTotal');

  const weighted = weightedEl ? weightedEl.textContent : '--';
  const overall = overallEl ? overallEl.textContent : '--';
  const passRate = passRateEl ? passRateEl.textContent : '--';
  const total = totalEl ? totalEl.textContent : '--';

  const now = new Date().toLocaleString('zh-CN');

  // 各维度的表格行
  let dimRows = '';
  if (_promptTestResults.length > 0) {
    const dims = {};
    _promptTestResults.forEach(r => {
      if (r.scores) {
        Object.entries(r.scores).forEach(([dim, score]) => {
          if (!dims[dim]) dims[dim] = [];
          dims[dim].push(score);
        });
      }
    });
    dimRows = Object.entries(dims).map(([dim, scores]) => {
      const avg = (scores.reduce((a,b)=>a+b,0) / scores.length * 100).toFixed(0);
      return `<tr><td>${dim}</td><td>${avg}%</td><td>${scores.length}</td></tr>`;
    }).join('');
  }

  // 测试用例表格
  let caseRows = '';
  _promptTestResults.forEach(r => {
    const ws = (r.weighted_score || 0).toFixed(0);
    const status = r.passed ? '通过' : '未通过';
    caseRows += `<tr>
      <td>${escHtml(r.id)}</td>
      <td>${escHtml(r.category)}</td>
      <td>${escHtml(r.query)}</td>
      <td>${ws}%</td>
      <td>${status}</td>
      <td>${r.duration.toFixed(1)}s</td>
    </tr>`;
  });

  const html = `<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>Prompt 评测报告</title>
<style>
  body{font-family:"Microsoft YaHei","PingFang SC",sans-serif;padding:40px;color:#333;max-width:1000px;margin:auto}
  h1{font-size:22px;border-bottom:2px solid #c0392b;padding-bottom:8px;margin-bottom:20px}
  h2{font-size:16px;color:#c0392b;margin-top:24px;margin-bottom:12px}
  table{width:100%;border-collapse:collapse;margin-bottom:20px;font-size:12px}
  th{background:#f5f5f5;padding:8px 10px;text-align:left;border:1px solid #ddd;font-weight:600}
  td{padding:8px 10px;border:1px solid #ddd}
  tr:nth-child(even){background:#fafafa}
  .summary{display:flex;gap:16px;margin-bottom:20px}
  .summary-item{flex:1;background:#f9f9f9;border-radius:6px;padding:12px 16px;text-align:center}
  .summary-num{font-size:24px;font-weight:700;color:#c0392b;display:block}
  .summary-label{font-size:11px;color:#999;margin-top:4px}
  .footer{margin-top:40px;font-size:11px;color:#999;border-top:1px solid #eee;padding-top:12px}
</style>
</head>
<body>
  <h1>📋 Prompt 质量评测报告</h1>
  <p style="font-size:13px;color:#666">生成时间: ${now}</p>

  <h2>总体概览</h2>
  <div class="summary">
    <div class="summary-item"><span class="summary-num">${weighted}</span><span class="summary-label">加权总分</span></div>
    <div class="summary-item"><span class="summary-num">${overall}</span><span class="summary-label">总体得分</span></div>
    <div class="summary-item"><span class="summary-num">${passRate}</span><span class="summary-label">通过率</span></div>
    <div class="summary-item"><span class="summary-num">${total}</span><span class="summary-label">测试总数</span></div>
  </div>

  <h2>各维度平均得分</h2>
  <table><thead><tr><th>维度</th><th>平均得分</th><th>测试次数</th></tr></thead><tbody>
    ${dimRows || '<tr><td colspan="3" style="text-align:center;color:#999">暂无数据</td></tr>'}
  </tbody></table>

  <h2>测试用例明细</h2>
  <table><thead><tr><th>ID</th><th>类别</th><th>问题</th><th>加权得分</th><th>状态</th><th>耗时</th></tr></thead><tbody>
    ${caseRows || '<tr><td colspan="6" style="text-align:center;color:#999">暂无数据</td></tr>'}
  </tbody></table>

  <div class="footer">网络安全移动运营商智能 Agent · Prompt 评测系统</div>
</body>
</html>`;

  // 下载 .doc（Word 能打开 HTML）
  const blob = new Blob([html], {type: 'application/msword;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `prompt-评测报告_${new Date().toISOString().slice(0,10)}.doc`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('📄 Word 报告已下载');
}

// ---- System Prompt 显示（只读）----
async function toggleSystemPrompt() {
  const panel = document.getElementById('systemPromptPanel');
  if (panel.style.display === 'block') {
    panel.style.display = 'none';
    return;
  }
  try {
    const resp = await fetch('/api/prompt/system-prompt');
    const data = await resp.json();
    document.getElementById('systemPromptContent').textContent = data.system_prompt || '获取失败';
    panel.style.display = 'block';
  } catch (e) {
    showToast('❌ 获取 System Prompt 失败: ' + e.message);
  }
}

async function loadPromptHistory() {
  try {
    const resp = await fetch('/api/prompt/test/history?limit=20');
    const data = await resp.json();
    const history = data.history;

    if (!history || history.length === 0) return;

    if (promptHistoryChart) promptHistoryChart.dispose();

    promptHistoryChart = makeChart('promptHistoryChart', {
      title: {text: '历史评测趋势', textStyle:{fontSize:14,fontWeight:600}},
      tooltip: {trigger:'axis'},
      legend: {data:['加权总分','总体得分','通过率'], textStyle:{fontSize:11}, bottom:0},
      xAxis: {type:'category', data:history.map(h=>new Date(h.timestamp).toLocaleDateString('zh-CN')).reverse()},
      yAxis: {type:'value', min:0, max:100, name:'分数', axisLabel:{fontSize:11}},
      series: [
        {name:'加权总分', type:'line', smooth:true, symbol:'circle', symbolSize:8, data:history.map(h=>h.weighted_score).reverse(), itemStyle:{color:'#c0392b'}, lineStyle:{width:2}},
        {name:'总体得分', type:'line', smooth:true, symbol:'circle', symbolSize:8, data:history.map(h=>h.overall_score).reverse(), itemStyle:{color:'#3498db'}, lineStyle:{width:2}},
        {name:'通过率', type:'line', smooth:true, symbol:'circle', symbolSize:8, data:history.map(h=>h.pass_rate).reverse(), itemStyle:{color:'#27ae60'}, lineStyle:{width:2}},
      ],
    });
  } catch (e) {
    console.error('加载历史失败:', e);
  }
}

async function loadPromptVersions() {
  try {
    const resp = await fetch('/api/prompt/versions');
    const data = await resp.json();
    const versions = data.versions || [];

    const container = document.getElementById('promptVersions');
    if (versions.length === 0) {
      container.innerHTML = '<div style="color:var(--t2);font-size:13px;padding:20px;text-align:center">暂无版本，修改 system prompt 后需手动创建版本</div>';
      return;
    }

    const rows = versions.map(v => {
      const isActive = v.is_active === 1;
      return `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px;border-bottom:1px solid rgba(0,0,0,0.03)">
        <div>
          <span style="font-weight:600;color:var(--t)">${v.version_name}</span>
          <span style="color:var(--t2);font-size:11px;margin-left:8px">${v.description || ''}</span>
        </div>
        <div>
          ${isActive ? '<span style="color:green;font-size:11px">● 激活</span>' :
            `<button onclick="switchVersion('${v.version_name}')" style="background:var(--b);color:var(--t);border:none;padding:4px 10px;border-radius:4px;font-size:11px;cursor:pointer;font-family:var(--f)">切换</button>`}
        </div>
      </div>`;
    }).join('');

    container.innerHTML = rows;
  } catch (e) {
    console.error('加载版本失败:', e);
  }
}

async function switchVersion(versionName) {
  if (!confirm(`确认切换到版本 "${versionName}"？`)) return;
  try {
    const resp = await fetch('/api/prompt/versions/switch', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({version_name: versionName}),
    });
    const data = await resp.json();
    if (data.ok) {
      showToast(`已切换到 ${versionName}`);
      loadPromptVersions();
    } else {
      showToast('切换失败: ' + data.message);
    }
  } catch (e) {
    showToast('切换失败: ' + e.message);
  }
}

async function showElasticTest() {
  const panel = document.getElementById('elasticTestPanel');
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
  if (panel.style.display === 'block') {
    const query = prompt('请输入要测试的问题:', '等保二级有哪些基本要求');
    if (!query) return;

    const container = document.getElementById('elasticTestResults');
    container.innerHTML = '<div style="padding:20px;color:var(--t2)">⏳ 正在运行弹性测试...</div>';

    try {
      const resp = await fetch(`/api/prompt/elastic/${encodeURIComponent(query)}`);
      const data = await resp.json();
      const results = data.results;

      const rows = Object.entries(results).map(([name, r]) => {
        const pass = r.answer_length > 50;
        return `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px;border-bottom:1px solid rgba(0,0,0,0.03)">
          <div style="flex:1">
            <span style="font-weight:600;color:var(--t);font-size:12px">${name}</span>
            <div style="color:var(--t2);font-size:11px;margin-top:4px">${r.query}</div>
          </div>
          <div style="text-align:right">
            <span style="color:${pass?'green':'orange'};font-size:12px">${pass?'✅':'⚠️'}</span>
            <div style="color:var(--t2);font-size:11px;margin-top:4px">${r.duration}s · ${r.answer_length}字</div>
          </div>
        </div>`;
      }).join('');

      container.innerHTML = `<div style="padding:10px 0;font-size:12px;color:var(--t2)">📌 基线问题: "${query}"</div>` + rows;
    } catch (e) {
      container.innerHTML = `<div style="color:var(--r)">❌ ${e.message}</div>`;
    }
  }
}
</script>
</body>
</html>